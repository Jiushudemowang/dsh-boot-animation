{
  "name": "dsh-boot-animation",
  "version": "0.2.1",
  "description": "鲸鱼娘启动加载动画：点击进入（Esc/空格放行）、多片随机、启动进度可见、失败有兜底。不改 DSH 本体源码。 修改版：新增「固定片目」，可在设置里指定每次开机播哪一段。",
  "license": "MIT",
  "author": "lxj5820",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiushudemowang/dsh-boot-animation.git"
  },
  "homepage": "https://github.com/Jiushudemowang/dsh-boot-animation#readme",
  "bugs": {
    "url": "https://github.com/Jiushudemowang/dsh-boot-animation/issues"
  },
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "src",
    "cordis.patch.yml",
    "entry.js",
    "package.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}